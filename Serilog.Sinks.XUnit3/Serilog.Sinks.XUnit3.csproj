<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackageId>Serilog.Sinks.XUnit3</PackageId>
        <Description>The xUnit.v3 injectable test output sink for Serilog</Description>
        <Authors>Stepami</Authors>
        <Company>N/A</Company>
        <Copyright>Copyright © Stepami 2025</Copyright>
        <RepositoryUrl>https://github.com/Stepami/serilog-sinks-xunit-v3</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/Stepami/serilog-sinks-xunit-v3</PackageProjectUrl>
        <Title>Serilog.Sinks.XUnit3</Title>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageTags>logging Serilog xUnit xUnit.v3 xUnit3 xUnit-v3 ITestOutputHelper</PackageTags>
        <IsPackable>true</IsPackable>
        <DocumentationFile>bin\$(Configuration)\net8.0\Serilog.Sinks.XUnit3.xml</DocumentationFile>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="xunit.v3.extensibility.core" Version="3.2.2" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../LICENSE" Pack="true" Visible="false" PackagePath=""/>
		<None Include="../README.md" Pack="true" Visible="false" PackagePath=""/>
		<None Include="../icon.png" Pack="true" Visible="false" PackagePath=""/>
	</ItemGroup>

</Project>
